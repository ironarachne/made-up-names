{
  "name": "@ironarachne/made-up-names",
  "version": "2.4.1",
  "description": "A module for generating fictional names",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "scripts": {
    "biome": "biome ci src/*.ts",
    "build": "tsc",
    "docs": "typedoc --out docs src/index.ts",
    "generate:names": "ts-node-esm scripts/generate-names.ts",
    "score:variety": "ts-node-esm scripts/score-variety.ts",
    "score:corpus-structure": "ts-node-esm scripts/score-corpus-structure.ts",
    "report:culture-quality": "ts-node-esm scripts/report-culture-quality.ts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/ironarachne/made-up-names.git"
  },
  "keywords": [
    "names"
  ],
  "author": "Ben Overmyer <ben@overmyer.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://codeberg.org/ironarachne/made-up-names/issues"
  },
  "homepage": "https://made-up-names.ironarachne.com/docs",
  "devDependencies": {
    "@babel/preset-env": "^7.22.9",
    "@babel/preset-typescript": "^7.22.5",
    "@biomejs/biome": "1.5.3",
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.7",
    "typescript": "^5.1.6",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@ironarachne/rng": "^2.3.1",
    "@ironarachne/word-generator": "^2.3.1"
  }
}
