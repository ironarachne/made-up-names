{
  "name": "@ironarachne/made-up-names",
  "version": "3.0.0",
  "description": "A library for generating random fictional names.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "docs": "typedoc --out docs src/index.ts",
    "generate:names": "tsx scripts/generate-names.ts",
    "lint": "biome ci src tools tests scripts",
    "lint:fix": "biome check --fix src tools tests scripts",
    "prepublishOnly": "npm run build",
    "report:culture-quality": "tsx scripts/report-culture-quality.ts",
    "score:corpus-structure": "tsx scripts/score-corpus-structure.ts",
    "score:variety": "tsx scripts/score-variety.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.tools.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ironarachne/made-up-names.git"
  },
  "keywords": [
    "ironarachne",
    "names",
    "generator",
    "fantasy"
  ],
  "author": "Ben Overmyer <ben@overmyer.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ironarachne/made-up-names/issues"
  },
  "homepage": "https://ironarachne.github.io/made-up-names",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^20.19.43",
    "tsx": "^4.20.0",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@ironarachne/rng": "^3.0.1",
    "@ironarachne/word-generator": "^3.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
